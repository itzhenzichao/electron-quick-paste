{
  "name": "electron-quick-paste",
  "productName": "NianYiTuo",
  "version": "2.1.4",
  "description": "快捷粘贴工具",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder",
    "pack:win": "npm run build && electron-builder --win",
    "pack:mac": "npm run build && electron-builder --mac",
    "release": "npm run build && electron-builder",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "author": "zzc",
  "license": "MIT",
  "dependencies": {
    "auto-launch": "^5.0.5",
    "electron-store": "^8.1.0",
    "naive-ui": "^2.40.0",
    "pinia": "^2.2.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^27.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "7.2.6",
    "vue-tsc": "^3.3.7"
  }
}
