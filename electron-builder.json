{
  "appId": "com.quickpaste.app",
  "productName": "NianYiTuo",
  "directories": {
    "output": "release"
  },
  "compression": "maximum",
  "files": [
    "out/main/index.js",
    "out/preload/**/*",
    "out/renderer/**/*",
    "build/**/*",
    "package.json",
    "!**/locales/!(zh-CN|en-US)*.pak"
  ],
  "extraMetadata": {
    "main": "out/main/index.js"
  },
  "asar": true,
  "asarUnpack": [],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.png"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.png",
    "category": "public.app-category.productivity",
    "extendInfo": {
      "LSUIElement": 1
    }
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "language": "2052",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "NianYiTuo",
    "uninstallDisplayName": "NianYiTuo",
    "runAfterFinish": true,
    "include": "build/installer.nsh"
  },
  "dmg": {
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  }
}